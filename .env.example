# Copy to .env.local when actual Supabase configuration is available.
# Only the project URL and a browser-safe publishable key belong here.
# Never use a secret or service-role key. Placeholders do not make network requests.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Optional: exact existing public Storage bucket for hotel_images.storage_path.
# Leave blank until its access policies have been configured.
VITE_SUPABASE_HOTEL_IMAGES_BUCKET=
